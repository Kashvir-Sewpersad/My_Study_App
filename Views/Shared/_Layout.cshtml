<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My_Study_App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/My_Study_App.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">My_Study_App</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text me-3">
                            Time studying: <strong id="study-timer">00:00:00</strong>
                            <small id="study-timer-status" class="ms-1"></small>
                        </span>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - My_Study_App - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function () {
                const IDLE_MS = 15 * 60 * 1000;   // 15 minutes
                const KEY = 'studyTimer';
                const loginTime = '@User.FindFirst("LoginTime")?.Value';

                const display = document.getElementById('study-timer');
                const statusEl = document.getElementById('study-timer-status');
                if (!display) return;

                // Load saved state, or start fresh if this is a new login
                let state = null;
                try { state = JSON.parse(sessionStorage.getItem(KEY)); } catch (e) {}
                const now = Date.now();
                if (!state || state.loginTime !== loginTime) {
                    state = { loginTime: loginTime, accumulated: 0, lastTick: now, lastActivity: now };
                }

                function save() {
                    try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
                }

                function format(ms) {
                    const total = Math.floor(ms / 1000);
                    const h = String(Math.floor(total / 3600)).padStart(2, '0');
                    const m = String(Math.floor((total % 3600) / 60)).padStart(2, '0');
                    const s = String(total % 60).padStart(2, '0');
                    return h + ':' + m + ':' + s;
                }

                function tick() {
                    const now = Date.now();
                    // Only count time up to the moment the idle limit is reached
                    const activeUntil = Math.min(now, state.lastActivity + IDLE_MS);
                    if (activeUntil > state.lastTick) {
                        state.accumulated += activeUntil - state.lastTick;
                    }
                    state.lastTick = now;

                    const idle = (now - state.lastActivity) >= IDLE_MS;
                    display.textContent = format(state.accumulated);
                    statusEl.textContent = idle ? '(paused - no activity)' : '';
                    statusEl.className = idle ? 'ms-1 text-danger' : 'ms-1';
                    save();
                }

                function onActivity() {
                    // Settle the idle period first, then resume counting
                    tick();
                    state.lastActivity = Date.now();
                    state.lastTick = state.lastActivity;
                }

                ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(function (evt) {
                    document.addEventListener(evt, onActivity, { passive: true });
                });

                window.addEventListener('beforeunload', function () { tick(); });

                tick();
                setInterval(tick, 1000);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>