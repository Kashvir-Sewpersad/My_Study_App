<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - My_Study_App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/My_Study_App.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">My_Study_App</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="StudyPlan" asp-action="Index">Study Plans</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Calendar" asp-action="Index">Calendar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Music" asp-action="Index">Music</a>
                        </li>
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text me-3">
                            Time studying: <strong id="study-timer">00:00:00</strong>
                            <small id="study-timer-status" class="ms-1"></small>
                        </span>

                        <form id="end-session-form" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">End Session</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - My_Study_App - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @Html.AntiForgeryToken()
        <script>
            (function () {
                const IDLE_MS = 15 * 60 * 1000;   // 15 minutes
                const SAVE_EVERY_MS = 30 * 1000;  // save to DB every 30 seconds
                const KEY = 'studyTimer';
                const loginTime = '@User.FindFirst("LoginTime")?.Value';

                const display = document.getElementById('study-timer');
                const statusEl = document.getElementById('study-timer-status');
                if (!display) return;

                let state = null;
                try { state = JSON.parse(sessionStorage.getItem(KEY)); } catch (e) {}
                const now = Date.now();
                if (!state || state.loginTime !== loginTime) {
                    state = { loginTime: loginTime, accumulated: 0, lastTick: now, lastActivity: now, lastSaved: 0 };
                }

                let ending = false;

                function save() {
                    try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
                }

                function format(ms) {
                    const total = Math.floor(ms / 1000);
                    const h = String(Math.floor(total / 3600)).padStart(2, '0');
                    const m = String(Math.floor((total % 3600) / 60)).padStart(2, '0');
                    const s = String(total % 60).padStart(2, '0');
                    return h + ':' + m + ':' + s;
                }

                function tick() {
                    const now = Date.now();
                    const activeUntil = Math.min(now, state.lastActivity + IDLE_MS);
                    if (activeUntil > state.lastTick) {
                        state.accumulated += activeUntil - state.lastTick;
                    }
                    state.lastTick = now;

                    const idle = (now - state.lastActivity) >= IDLE_MS;
                    display.textContent = format(state.accumulated);
                    statusEl.textContent = idle ? '(paused - no activity)' : '';
                    statusEl.className = idle ? 'ms-1 text-danger' : 'ms-1';
                    save();
                }

                // Send the current total to the server (only if it changed since last save)
                function saveToServer() {
                    const seconds = Math.floor(state.accumulated / 1000);
                    if (seconds === state.lastSaved) return Promise.resolve();

                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (!tokenInput) return Promise.resolve();

                    return fetch('/StudyTime/Save', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': tokenInput.value
                        },
                        body: JSON.stringify({ activeSeconds: seconds }),
                        keepalive: true   // lets the request finish even while the page is closing
                    }).then(function (r) {
                        if (r.ok) { state.lastSaved = seconds; save(); }
                    }).catch(function () { /* try again at the next interval */ });
                }

                function onActivity() {
                    tick();
                    state.lastActivity = Date.now();
                    state.lastTick = state.lastActivity;
                }

                ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(function (evt) {
                    document.addEventListener(evt, onActivity, { passive: true });
                });

                // End Session: save final time, clear local timer data, then log out
                const endForm = document.getElementById('end-session-form');
                if (endForm) {
                    endForm.addEventListener('submit', function (e) {
                        e.preventDefault();
                        ending = true;
                        tick();
                        saveToServer().finally(function () {
                            try { sessionStorage.removeItem(KEY); } catch (err) {}
                            endForm.submit();   // submit() skips this listener, so no loop
                        });
                    });
                }

                window.addEventListener('beforeunload', function () {
                    if (!ending) { tick(); saveToServer(); }
                });
                document.addEventListener('visibilitychange', function () {
                    if (document.visibilityState === 'hidden' && !ending) { tick(); saveToServer(); }
                });

                tick();
                setInterval(tick, 1000);
                setInterval(saveToServer, SAVE_EVERY_MS);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>